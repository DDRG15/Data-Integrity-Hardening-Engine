# Copy this file to .env and fill in values before running.
# Never commit .env to version control.
#
# Logging is configured by the consuming application, not by env vars.
# To enable debug logging in your script or shell session:
#   Python: logging.basicConfig(level=logging.DEBUG)
#   Shell:  PYTHONPATH=src python -c "import logging; logging.basicConfig(level=logging.DEBUG); from dih_engine import ..."

# ── Extraction Engine ────────────────────────────────────────────────────────
DEE_PAUSE_THRESHOLD=80.0
DEE_DISK_THRESHOLD=95.0

# ── Seer Recon ───────────────────────────────────────────────────────────────
SEER_INPUT_CSV=data/urls.csv
SEER_OUTPUT_FILE=output/recon_plan.csv
SEER_REQUEST_TIMEOUT=10
SEER_SAMPLE_SIZE=3

# ── API Service (optional -- pip install "dih-engine[api]") ───────────────────
# Required by every data route. Fail-closed: the service returns 503 until set.
# Generate a strong value: python -c "import secrets; print(secrets.token_urlsafe(32))"
DIH_API_KEY=

# ── Notifications ────────────────────────────────────────────────────────────
# Both are optional. Set one or both -- unset channels are skipped silently.

# Slack: https://api.slack.com/apps -> Your App -> Incoming Webhooks
SLACK_WEBHOOK_URL=

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# ── FlareSolverr (second-level fallback -- self-hosted, no account needed) ───
# Solves Cloudflare JS challenges using a real Chrome browser.
# Start once: docker compose up -d flaresolverr
FLARE_SOLVER_URL=http://localhost:8191/v1

# ── Proxy (third-level fallback for persistent WAF blocks) ────────────────────
# Activated automatically when requests + curl_cffi both return 403/ssl_error.
# Set ONE of the following (DIH_PROXY_URL takes priority over SCRAPFLY):

# Option A: any HTTP/SOCKS5 proxy (Oxylabs, BrightData, Smartproxy, etc.)
# SOCKS5 requires: pip install "dih-engine[proxy]"
DIH_PROXY_URL=

# Option B: Scrapfly API -- free tier available at https://scrapfly.io
SCRAPFLY_API_KEY=
