# Copy this file to .env and fill in values before running.
# Never commit .env to version control.

# ── Extraction Engine ────────────────────────────────────────────────────────
DEE_LOG_LEVEL=INFO

# ── Sanitizer Core ───────────────────────────────────────────────────────────
SC_LOG_LEVEL=INFO

# ── Seer Recon ───────────────────────────────────────────────────────────────
SEER_INPUT_CSV=data/urls.csv
SEER_OUTPUT_FILE=output/recon_plan.csv
SEER_REQUEST_TIMEOUT=10
SEER_SAMPLE_SIZE=3
SEER_LOG_LEVEL=INFO
